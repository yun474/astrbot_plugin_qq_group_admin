                    "condition": {
                      "keyword_settings.enable_join_keyword_review": true
                    }
                  },
                  "join_keyword_priority": {
                    "description": "同时命中白词和黑词时的优先规则",
                    "type": "string",
                    "options": [
                      "黑词优先",
                      "白词优先"
                    ],
                    "default": "黑词优先",
                    "hint": "黑词优先：同时命中则拒绝；白词优先：同时命中则同意。不同回答分别命中白词和黑词也按此规则处理。",
                    "condition": {
                      "keyword_settings.enable_join_keyword_review": true
                    }
                  },
                  "enable_keyword_mute": {
                    "description": "启用违禁词自动禁言",
                    "type": "bool",
                    "default": false,
                    "hint": "检查机器人实际收到的 QQ 群消息正文，命中后禁言发送者并停止后续指令和 LLM 处理。成功、失败均不向群里提示，失败仅记日志；不检查引用原文、图片或语音。"
                  },
                  "mute_keywords": {
                    "description": "消息违禁词",
                    "type": "list",
                    "items": {
                      "type": "string"
                    },
                    "default": [],
                    "hint": "消息正文包含任一词条即触发，留空不处理。",
                    "condition": {
                      "keyword_settings.enable_keyword_mute": true
                    }
