                  "keyword_mute_duration": {
                    "description": "违禁词禁言时长",
                    "type": "string",
                    "default": "10分",
                    "hint": "支持 30秒、10分、2小时、1天2小时；纯数字按分钟。必须大于 0，且不超过安全限制中的单次最长禁言秒数。",
                    "condition": {
                      "keyword_settings.enable_keyword_mute": true
                    }
                  }
                },
                "condition": {
                  "confirmed": true
                }
              }
            }
          }
